{
  "name": "echiquier-ledonien/dame",
  "description": "Dossier Administratif des Membres Échiquéens",
  "type": "wordpress-plugin",
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.4",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
  },
  "scripts": {
    "lint:php": "phpstan analyze",
    "lint": "phpcs",
    "fix": "phpcbf"
 },
  "autoload-dev": {
    "psr-4": {
      "DAME\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "szepeviktor/phpstan-wordpress": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "setasign/fpdf": "^1.8",
    "setasign/fpdi": "^2.6"
  }
}
