<?xml version="1.0"?>
<ruleset name="DAME_WordPress_Standards">
    <description>Standard de code WordPress pour le plugin DAME.</description>

    <!-- 1. Utiliser le standard officiel WordPress -->
    <rule ref="WordPress" />

    <!-- Configurer le text domain pour l'i18n -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain">
                <element value="dame" />
            </property>
        </properties>
    </rule>

    <!-- Déclarer les capacités personnalisées -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="edit_dame_messages" />
                <element value="manage_dame_options" />
            </property>
        </properties>
    </rule>

    <!-- Définir la version minimale de WP supportée -->
    <config name="minimum_wp_version" value="6.7" />

    <!-- Exclusion du nommage de fichier strict WP pour garder la convention PSR-4/PascalCase du projet -->
    <rule ref="WordPress.Files.FileName">
        <severity>0</severity>
    </rule>

    <!-- Ignorer l'obligation du point final sur les commentaires en ligne -->
    <rule ref="Squiz.Commenting.InlineComment.InvalidEndChar">
        <severity>0</severity>
    </rule>

    <!-- Ignorer les warnings de formatage des docblocks trop stricts -->
    <rule ref="Generic.Commenting.DocComment.MissingShort">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FileComment">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.ClassComment">
        <severity>0</severity>
    </rule>

    <!-- Ne pas imposer les Yoda Conditions en PHP 8.4 -->
    <rule ref="WordPress.PHP.YodaConditions">
        <severity>0</severity>
    </rule>

    <!-- Ignorer les avertissements d'optimisation BDD (meta_query / tax_query légitimes) -->
    <rule ref="WordPress.DB.SlowDBQuery">
        <severity>0</severity>
    </rule>

    <!-- Ignorer les paramètres inutilisés dans les callbacks d'actions/filtres WP -->
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <severity>0</severity>
    </rule>

    <!-- Autoriser l'opérateur ternaire court (?:) -->
    <rule ref="Universal.Operators.DisallowShortTernary">
        <severity>0</severity>
    </rule>

    <!-- 2. Fichiers & dossiers à analyser -->
    <file>dame.php</file>
    <file>uninstall.php</file>
    <file>includes</file>

    <!-- 3. Exclusions obligatoires -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/includes/lib/*</exclude-pattern>

    <!-- 4. Paramètres de confort -->
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>
</ruleset>