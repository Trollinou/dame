{
  "name": "dame",
  "version": "4.8.6",
  "description": "Dossier Administratif des Membres Échiquéens",
  "scripts": {
    "build:css": "sass src/scss/:assets/css/ --style=compressed --no-source-map",
    "build:js": "node minify-js.js",
    "build": "npm run build:css && npm run build:js",
    "lint:js": "wp-scripts lint-js src/js/",
    "package": "node script/package.cjs",
    "watch": "sass --watch src/scss/:assets/css/"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@playwright/test": "^1.62.1",
    "@wordpress/scripts": "^34.0.0",
    "adm-zip": "^0.6.0",
    "minimatch": "^10.2.6",
    "sass": "^1.102.0",
    "terser": "^5.49.2"
  },
  "dependencies": {
    "pinia": "^4.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "unrs-resolver@1.12.2": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true,
    "@parcel/watcher@2.6.0": true
  },
  "overrides": {
    "react": "^18.3.1"
  }
}